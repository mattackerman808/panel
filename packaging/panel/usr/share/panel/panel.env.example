# /etc/panel/panel.env — configuration for panel.service (systemd
# EnvironmentFile: KEY=value, # comments allowed, no shell quoting).
#
# On real hosts this file is managed by Salt from pillar. The shipped
# default leaves credentials blank, which puts the server in mock mode
# (synthetic data) until a UDM/UPS is configured — so a fresh install
# comes up serving a working dashboard without secrets in the package.

# Bind loopback only; the reverse proxy (Apache/Caddy) is the public face.
HOST=127.0.0.1
PORT=4000

# --- UniFi UDM Pro Max ---
UDM_HOST=
UDM_API_KEY=
UDM_USERNAME=
UDM_PASSWORD=
UDM_SITE=default
UDM_INSECURE_TLS=1
UDM_SNMP_COMMUNITY=public
UDM_SNMP_PORT=161
UDM_WAN_IFINDEXES=
UDM_WAN_LABELS=
# Plan/link speed per WAN in Mbps (same order as the WANs), e.g. 10000,2500.
UDM_WAN_SPEEDS=

# --- UPS power monitoring (SNMP) ---
# e.g. UPS_HOST=ups.808.org, UPS_SNMP_COMMUNITY=snmpro
UPS_HOST=
UPS_SNMP_COMMUNITY=public
UPS_SNMP_PORT=161
PANEL_POLL_UPS_MS=5000

# --- Tesla Powerwall (energy kiosk) ---
# Gateway address on the LAN. Leave blank to disable. When set, the same
# server also drives the home-power kiosk: open it on any hostname that
# starts with "energy." (e.g. energy.example.org behind the same reverse
# proxy) or add ?view=energy to the URL.
POWERWALL_HOST=
# Customer login password. On a Powerwall 3 it is the last 5 characters of
# the password printed on the unit's label. The gateway rate-limits failed
# logins (HTTP 429); the server backs off on its own.
POWERWALL_PASSWORD=
# How often (ms) to read the gateway's meters.
PANEL_POLL_POWERWALL_MS=5000
# Name on the energy kiosk's top bar (defaults to PANEL_SITE_NAME).
# PANEL_ENERGY_SITE_NAME=Home

# --- SPAN smart panel (Circuits page on the energy kiosk) ---
# Panel address on the LAN. Leave blank to disable.
SPAN_HOST=
# The panel's local passphrase: SPAN Home app → On-premise settings → Local
# network. It is also the panel's MQTT broker password. SPAN's local API is
# for personal, non-commercial use on the home LAN.
SPAN_PASSPHRASE=
# Name of the SPAN circuit the rack UPS is plugged in behind (e.g. an
# unmetered subpanel). The Circuits page splits it into the UPS's measured
# output and the rest; the two labels name those shares.
# PANEL_UPS_CIRCUIT=Subpanel
# PANEL_UPS_CIRCUIT_LABEL=Server cabinet
# PANEL_UPS_CIRCUIT_REST=Everything else

# --- Plug-in solar (APsystems EZ1 microinverters, energy kiosk) ---
# Comma-separated inverter hosts. Enable the local API first: AP EasyPower
# app → Direct Connection (Bluetooth) → Settings → Local Mode → on,
# Continuous (needs EZ1 firmware with Local Mode). It then serves JSON on
# :8050 with no auth. Leave blank to disable. The gateway sees plug-in
# output only as lower home load, so the server adds it to BOTH solar and
# home. Inverters sleep at night; that raises no event.
APSYSTEMS_HOSTS=
# Optional labels, same order as the hosts.
# APSYSTEMS_NAMES=Balcony
# PANEL_POLL_APSYSTEMS_MS=10000
# SPAN circuit the inverters plug into. SPAN meters it net of their output;
# the Circuits page adds the output back there (and either way keeps it out
# of the "Unmetered" gap).
# PANEL_PLUGIN_SOLAR_CIRCUIT=Garage / Outlets

# --- Display ---
# Name in the top-left corner; page rotation order and dwell (ms). Page ids:
# overview, internet, wired, wireless, clients, topology, power.
PANEL_SITE_NAME=Network
PANEL_UI_PAGES=
PANEL_UI_DWELL_MS=24000

# Set to 1 to force synthetic data regardless of the above.
PANEL_MOCK=0
