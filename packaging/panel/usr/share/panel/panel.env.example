# /etc/panel/panel.env — configuration for panel.service (systemd
# EnvironmentFile: KEY=value, # comments allowed, no shell quoting).
#
# On real hosts this file is managed by Salt from pillar. The shipped
# default leaves credentials blank, which puts the server in mock mode
# (synthetic data) until a UDM/UPS is configured — so a fresh install
# comes up serving a working dashboard without secrets in the package.

# Bind loopback only; the reverse proxy (Apache/Caddy) is the public face.
HOST=127.0.0.1
PORT=4000

# --- UniFi UDM Pro Max ---
UDM_HOST=
UDM_API_KEY=
UDM_USERNAME=
UDM_PASSWORD=
UDM_SITE=default
UDM_INSECURE_TLS=1
UDM_SNMP_COMMUNITY=public
UDM_SNMP_PORT=161
UDM_WAN_IFINDEXES=
UDM_WAN_LABELS=
# Plan/link speed per WAN in Mbps (same order as the WANs), e.g. 10000,2500.
UDM_WAN_SPEEDS=

# --- UPS power monitoring (SNMP) ---
# e.g. UPS_HOST=ups.808.org, UPS_SNMP_COMMUNITY=snmpro
UPS_HOST=
UPS_SNMP_COMMUNITY=public
UPS_SNMP_PORT=161
PANEL_POLL_UPS_MS=5000

# --- Display ---
# Name in the top-left corner; page rotation order and dwell (ms). Page ids:
# overview, internet, wired, wireless, clients, topology, power.
PANEL_SITE_NAME=Network
PANEL_UI_PAGES=
PANEL_UI_DWELL_MS=24000

# Set to 1 to force synthetic data regardless of the above.
PANEL_MOCK=0
