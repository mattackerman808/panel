# Caddy reverse proxy for the panel dashboard — the low-friction option.
#
# Caddy provisions and renews a Let's Encrypt cert automatically (port 80/443
# must be reachable from the internet, or use the DNS challenge) and proxies
# WebSockets transparently, so /ws needs no special handling.
#
# Install:
#   sudo apt install caddy         # or the official Caddy repo
#   sudo cp Caddyfile /etc/caddy/Caddyfile   # edit the hostname first
#   sudo systemctl reload caddy
#
# For an internal-only host with no public DNS, replace the site address with
# `:80` (HTTP) or use `tls internal` for a self-signed cert Caddy manages.

panel.example.org {
    encode zstd gzip
    reverse_proxy 127.0.0.1:4000
}
