# --- UDM Pro Max connection ---
# IP or hostname of the UDM on your LAN (no scheme, no path).
UDM_HOST=192.168.1.1

# Integration API key (Settings > Control Plane > Integrations > Create API Key).
# This unlocks: clients list, device list, current rates.
UDM_API_KEY=

# Optional: local-account creds for the legacy API.
# Required only for DPI category data and historical bandwidth.
# Create under Settings > Admins & Users > Add new admin > Restrict to local access.
UDM_USERNAME=
UDM_PASSWORD=

# Site name in the controller (default site is usually "default").
UDM_SITE=default

# Set to "1" if your UDM uses a self-signed cert (default for stock UDMs).
UDM_INSECURE_TLS=1

# --- SNMP (real-time WAN throughput) ---
# Enable SNMPv2c on the UDM (Settings > System > SNMP). Required for the
# bandwidth chart — the legacy API caches WAN counters at ~30s intervals,
# so the chart uses SNMP for true real-time data.
UDM_SNMP_COMMUNITY=public
UDM_SNMP_PORT=161

# Comma-separated SNMP interface indexes for your WAN(s). Leave blank to
# auto-detect — the poller will (1) ask the UniFi controller which ports
# are designated WAN1/WAN2 and resolve those to SNMP ifIndexes, then
# (2) fall back to interfaces that hold a routable (non-RFC1918) IPv4.
# Only set this manually if both fail (no controller creds AND CGNAT/no
# public IP on the WAN). Run
# `snmpwalk -v2c -c public <udm> 1.3.6.1.2.1.31.1.1.1.1` to inspect.
# Example: UDM_WAN_IFINDEXES=3,4
UDM_WAN_IFINDEXES=

# Optional human-readable labels for each WAN, matching the order of
# UDM_WAN_IFINDEXES (or auto-detect order — which follows the controller's
# WAN1/WAN2 designation, so it stays stable across re-cables as long as
# you keep the WAN1/WAN2 assignments in the UniFi UI). Example:
# UDM_WAN_LABELS=ATT Fiber,Xfinity Cable
UDM_WAN_LABELS=

# --- UPS power monitoring (SNMP) ---
# Hostname/IP of a network-managed UPS. Leave blank to disable the power
# page entirely. The poller reads the vendor-neutral UPS-MIB (RFC 1628) and
# falls back to the APC PowerNet MIB for anything the standard MIB omits, so
# most managed UPSes work without extra config. The UPS may live on a
# different subnet from the UDM — it only needs to be routable from wherever
# the server runs.
UPS_HOST=
UPS_SNMP_COMMUNITY=public
UPS_SNMP_PORT=161

# How often (ms) to poll the UPS over SNMP. Cheap; 5s catches load spikes and
# transfer-to-battery events quickly.
PANEL_POLL_UPS_MS=5000

# --- Server ---
PORT=4000

# Interface to bind. Defaults to 0.0.0.0 (all interfaces). When running
# behind a reverse proxy on a VM (see deploy/install-vm.sh), set this to
# 127.0.0.1 so only the proxy can reach the server — panel-vm.service does
# this for you.
# HOST=0.0.0.0

# How often (ms) to re-attempt a subsystem that came up dead — SNMP WAN
# discovery or the controller connection. On a Pi the service can start
# before the network interface has an address; without this the poller
# would stay WAN-less (every chart blank) until a manual restart.
PANEL_POLL_RECOVERY_MS=30000

# --- Dev ---
# Set to "1" to use synthetic data instead of hitting the real UDM (good for laptop dev).
PANEL_MOCK=0
